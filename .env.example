# Supabase Configuration
# Copy this file to .env and fill in your actual Supabase credentials

# Supabase Project URL (from your Supabase project settings)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (from your Supabase project settings > API)
# This is the secret key that has full access to your Supabase project
# Never share this key or commit it to version control
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Storage bucket names (optional, defaults to these values if not set)
SUPABASE_SIGN_CARDS_BUCKET=sign-cards
SUPABASE_MODELS_BUCKET=models

# Server port (optional, defaults to 3000)
PORT=3000
